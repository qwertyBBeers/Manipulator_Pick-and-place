<?xml version="1.0" encoding="UTF-8"?>
<robot name="rb5_850e">
    <group name="mainpulation">
        <chain base_link="link0" tip_link="tcp"/>
    </group>

    <virtual_joint name="fixed_joint" type="fixed" parent_frame="world" child_link="link0"/>

    <!-- Original RB5 arm self-collision matrix from rbpodo_moveit_config. -->
    <disable_collisions link1="link0" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="link0" link2="link2" reason="Never"/>
    <disable_collisions link1="link0" link2="link3" reason="Never"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link3" reason="Never"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link5" reason="Never"/>
    <disable_collisions link1="link3" link2="link6" reason="Never"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="link6" reason="Never"/>
    <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>

    <!-- Fixed tool mount: keep tool-vs-world collisions, suppress internal tool collisions. -->
    <disable_collisions link1="link6" link2="tcp" reason="Adjacent"/>
    <disable_collisions link1="link6" link2="robotiq_85_base_link" reason="Adjacent"/>
    <disable_collisions link1="tcp" link2="robotiq_85_base_link" reason="Adjacent"/>

    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_inner_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_inner_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_base_link" link2="camera_bottom_screw_frame" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_base_link" link2="camera_link" reason="ToolInternal"/>

    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_finger_tip_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_finger_tip_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_inner_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_left_finger_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_right_finger_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_finger_link" reason="ToolInternal"/>
    <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_finger_tip_link" reason="ToolInternal"/>

    <disable_collisions link1="camera_bottom_screw_frame" link2="camera_link" reason="Adjacent"/>
    <disable_collisions link1="camera_link" link2="camera_depth_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_link" link2="camera_color_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_link" link2="camera_infra1_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_link" link2="camera_infra2_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_link" link2="camera_accel_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_link" link2="camera_gyro_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_depth_frame" link2="camera_depth_optical_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_color_frame" link2="camera_color_optical_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_infra1_frame" link2="camera_infra1_optical_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_infra2_frame" link2="camera_infra2_optical_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_accel_frame" link2="camera_accel_optical_frame" reason="Adjacent"/>
    <disable_collisions link1="camera_gyro_frame" link2="camera_gyro_optical_frame" reason="Adjacent"/>

    <disable_collisions link1="camera_link" link2="robotiq_85_left_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="camera_link" link2="robotiq_85_right_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="camera_link" link2="robotiq_85_left_finger_link" reason="ToolInternal"/>
    <disable_collisions link1="camera_link" link2="robotiq_85_right_finger_link" reason="ToolInternal"/>
    <disable_collisions link1="camera_link" link2="robotiq_85_left_inner_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="camera_link" link2="robotiq_85_right_inner_knuckle_link" reason="ToolInternal"/>
    <disable_collisions link1="camera_link" link2="robotiq_85_left_finger_tip_link" reason="ToolInternal"/>
    <disable_collisions link1="camera_link" link2="robotiq_85_right_finger_tip_link" reason="ToolInternal"/>
</robot>
